# =============================================================
# Gauss — root .gitignore
# Stack: Android/Gradle/Kotlin · Flutter/Dart · Python/Node scripts
# Nested .gitignore files also apply under flutter_app/ and
# flutter_app/android/. Patterns without a leading "/" match at
# any depth; keep it that way for build caches.
# =============================================================

# --- Android / Gradle / Kotlin ---
.gradle/
.kotlin/
build/
local.properties
captures/
.cxx/
*.iml
*.hprof
# Keep gradle-wrapper.jar tracked (reproducible builds) — do NOT ignore it.

# --- IDE / Editors ---
.idea/
.vscode/
*.iws
*.ipr
*.swp
*~

# --- Flutter / Dart (defense-in-depth; flutter_app/ has its own too) ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
.fvm/flutter_sdk/
coverage/
*.lcov
app.*.symbols
app.*.map.json
# Keep flutter_app/pubspec.lock tracked (app lockfile) — do NOT ignore it.

# --- Python scripts (scripts/*.py) ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# --- Node scripts (scripts/*.mjs) ---
node_modules/
.npm/
.yarn/cache/
.pnpm-store/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Logs / temp ---
*.log
tmp/
.cache/
*.tmp
*.temp
*.dmp
hs_err_pid*

# --- Packaged outputs (source assets and docs remain tracked) ---
*.apk
*.aab
*.apks
*.ipa
*.xcarchive/

# --- Signing — NEVER commit keystores or key material ---
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
keystore.properties
key.properties

# --- Secrets ---
.env
.env.*
!.env.example
!.env.*.example
.secrets/
secrets.properties

# --- OS cruft ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Misc ---
*.orig
*.orig.*
*.rej
