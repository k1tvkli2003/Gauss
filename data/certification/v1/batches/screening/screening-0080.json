}],[{"type":"text","text":"۲۵"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1824/option_3_4.webp","alt":"گزینه ۳","aspect_ratio":0.3802}],[{"type":"text","text":"۳۰"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1824/option_4_5.webp","alt":"گزینه ۴","aspect_ratio":0.365}]],"solution":[{"type":"text","text":"طبق تعریف احتمال داریم:\n$P(\\text{سیاه}) = \\dfrac{n(\\text{سیاه})}{n(S)}$\n$P(\\text{سفید}) = \\dfrac{n(\\text{سفید})}{n(S)}$\n$\\Rightarrow \\dfrac{n(\\text{سیاه})}{n(\\text{سفید})} = \\dfrac{P(\\text{سیاه})}{P(\\text{سفید})} \\Rightarrow \\dfrac{۲۰}{n} = ۴ \\Rightarrow n = ۵$\nتعداد مهره‌های سفید برابر ۵ و تعداد کل مهره‌ها ۲۵ می‌باشد."},{"type":"image","asset":"question_media/math/nardebam_math_1405_1824/solution_6.webp","alt":"راه حل سوال ۱۸۲۴","aspect_ratio":2.5462}],"smart_shortcut":null,"media_assets":["question_media/math/nardebam_math_1405_1824/option_1_2.webp","question_media/math/nardebam_math_1405_1824/option_2_3.webp","question_media/math/nardebam_math_1405_1824/option_3_4.webp","question_media/math/nardebam_math_1405_1824/option_4_5.webp","question_media/math/nardebam_math_1405_1824/solution_6.webp","question_media/math/nardebam_math_1405_1824/stem_1.webp"],"media_evidence":[{"asset":"question_media/math/nardebam_math_1405_1824/option_1_2.webp","sha256":"5510712119cd5c19912fb12e2ab729275f5ac75077a45487814fc0d22951e0b7","bytes":384},{"asset":"question_media/math/nardebam_math_1405_1824/option_2_3.webp","sha256":"4597a4ef0dbd5a1e327be3d05d74415dd91e3fd1decf551f84d51a7e9180b53a","bytes":734},{"asset":"question_media/math/nardebam_math_1405_1824/option_3_4.webp","sha256":"216b678221e84cf432f97798957ecc178edbe2c9c482f442b1fca99a830a18e4","bytes":1142},{"asset":"question_media/math/nardebam_math_1405_1824/option_4_5.webp","sha256":"66eb9914a8322fe2175bb54b39176015bb44d3056c7a0bc72337b9bc4217083c","bytes":1058},{"asset":"question_media/math/nardebam_math_1405_1824/solution_6.webp","sha256":"05ef384452dd21cc4eec4567aa