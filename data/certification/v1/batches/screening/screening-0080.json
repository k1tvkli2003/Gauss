"question_media/math/nardebam_math_1405_1826/stem_1.webp","alt":"صورت سوال 1826","aspect_ratio":0.0441}],"options":[[{"type":"text","text":"$\\dfrac{1}{9}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1826/option_1_2.webp","alt":"گزینه ۱","aspect_ratio":0.7152}],[{"type":"text","text":"$\\dfrac{5}{36}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1826/option_2_3.webp","alt":"گزینه ۲","aspect_ratio":0.5967}],[{"type":"text","text":"$\\dfrac{2}{9}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1826/option_3_4.webp","alt":"گزینه ۳","aspect_ratio":0.6923}],[{"type":"text","text":"$\\dfrac{1}{18}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1826/option_4_5.webp","alt":"گزینه ۴","aspect_ratio":0.6034}]],"solution":[{"type":"text","text":"پیشامد مورد نظر را $A$ می‌نامیم:\n$A = \\{(۱, ۱), (۲, ۲), (۳, ۳), (۴, ۴)\\}$\nبنابراین:\n$P(A) = \\dfrac{n(A)}{n(S)} = \\dfrac{۴}{\\binom{۹}{۲}} = \\dfrac{۴}{۳۶} = \\dfrac{۱}{۹}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1826/solution_6.webp","alt":"راه حل سوال ۱۸۲۶","aspect_ratio":2.6009}],"smart_shortcut":null,"media_assets":["question_media/math/nardebam_math_1405_1826/option_1_2.webp","question_media/math/nardebam_math_1405_1826/option_2_3.webp","question_media/math/nardebam_math_1405_1826/option_3_4.webp","question_media/math/nardebam_math_1405_1826/option_4_5.webp","question_media/math/nardebam_math_1405_1826/solution_6.webp","question_media/math/nardebam_math_1405_1826/stem_1.webp"],"media_evidence":[{"asset":"question_media/math/nardebam_math_1405_1826/option_1_2.webp","sha256":"59df46a7b3f2c7cc92a6ff9d2fd8e71df35fbb328f9194dd7425fe5306fd978d","bytes":94},{"asset":"question_media/math/nardebam_math_1405_1826/option_2_3.webp","sha256":"459eedda038e23739d2d58bd16bfbb99583218969a50ab8596fee78dccfe3b23","bytes":1116},{"asset":"question_media/math/nardebam_math_1405_1826/option_3_4.webp","sha256":"0873cd105e53846d8d5fdf7a72a19cfa