t":"question_media/math/nardebam_math_1405_1834/option_3_4.webp","alt":"گزینه ۳","aspect_ratio":0.5989}],[{"type":"text","text":"$\\dfrac{1}{9}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1834/option_4_5.webp","alt":"گزینه ۴","aspect_ratio":0.6089}]],"solution":[{"type":"text","text":"دقت داشته باشید که در فضای نمونه‌ای و پیشامد مورد نظر جایگشت دو عدد انتخابی اهمیت ندارد.\nپیشامد مورد نظر را $A$ می‌نامیم.\n$A = \\{(۴, ۱۰), (۵, ۹), (۶, ۸)\\}$\n$\\blacksquare$ جایگشت ۲ عدد انتخابی اهمیت ندارد.\nبنابراین:\n$P(A) = \\frac{n(A)}{n(S)} = \\frac{۳}{\\binom{۱۰}{۲}} = \\frac{۳}{۴۵} = \\frac{۱}{۱۵}$"}],"smart_shortcut":null,"media_assets":["question_media/math/nardebam_math_1405_1834/option_1_2.webp","question_media/math/nardebam_math_1405_1834/option_2_3.webp","question_media/math/nardebam_math_1405_1834/option_3_4.webp","question_media/math/nardebam_math_1405_1834/option_4_5.webp","question_media/math/nardebam_math_1405_1834/stem_1.webp"],"media_evidence":[{"asset":"question_media/math/nardebam_math_1405_1834/option_1_2.webp","sha256":"85577355d9560400a3a5ed5e67a57b7d0cba1c5eef6f499a6616120194ae86c1","bytes":1768},{"asset":"question_media/math/nardebam_math_1405_1834/option_2_3.webp","sha256":"5899585074d5a492e8b0f6a2699cc7a3add13250055b24fdc6f836d12178655c","bytes":1766},{"asset":"question_media/math/nardebam_math_1405_1834/option_3_4.webp","sha256":"a31bcebb7c34700f600e87928e9e4034c43aaabc511d58075df68f241eae1d9f","bytes":1034},{"asset":"question_media/math/nardebam_math_1405_1834/option_4_5.webp","sha256":"779a4d7702fe178acd46f6ca4026bb7797a1990dc5062670b2a9850ab38a93b5","bytes":1526},{"asset":"question_media/math/nardebam_math_1405_1834/stem_1.webp","sha256":"03e083cd9738c48c01c9d16b44f2109aa87d441ea97ed00242a0c344ae347259","bytes":10104}],"provenance":{"edition":"nardebam_1405","question_number":1834,"question_pdf":"16.pdf","question_page":10,"solution_page":169,"solution_origin":"source"},"source_answer_hidden":true}]}
