ion_page":170,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_math_1405_1840","source_sha256":"fa8a300ba8eb1216b4679daea4e01af24693deeed77be2c2f6bfc6d2ca6eb13c","subject":"math","section_id":"math_discrete_data","source_topic_key":"probability","source_difficulty":"hard","stem":[{"type":"text","text":"احتمال آن‌که در پرتاب دو تاس مجموع اعداد روشده زوج باشد، چند برابر احتمال آن است که در پرتاب سه تاس مجموع اعداد روشده زوج باشد؟"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1840/stem_1.webp","alt":"صورت سوال 1840","aspect_ratio":0.0314}],"options":[[{"type":"text","text":"$1$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1840/option_1_2.webp","alt":"گزینه ۱","aspect_ratio":0.4679}],[{"type":"text","text":"$\\dfrac{1}{2}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1840/option_2_3.webp","alt":"گزینه ۲","aspect_ratio":0.4679}],[{"type":"text","text":"$\\dfrac{1}{3}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1840/option_3_4.webp","alt":"گزینه ۳","aspect_ratio":0.4679}],[{"type":"text","text":"$\\dfrac{2}{3}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1840/option_4_5.webp","alt":"گزینه ۴","aspect_ratio":0.4679}]],"solution":[{"type":"text","text":"چون تعداد اعداد زوج و فرد هر تاس برابر است، در پرتاب دو تاس تقارن وجود دارد به این معنی که به ازای هر حالتی که مجموع دو تاس زوج باشد حالتی وجود دارد که مجموع آن‌ها فرد شود. این موضوع برای پرتاب سه تاس نیز صدق می‌کند؛ مثلاً اگر دو تاس اول $(1, 1)$ باشند در حالاتی که تاس سوم ۱ یا ۳ یا ۵ بیاید مجموع فرد و در حالاتی که ۲ یا ۴ یا ۶ بیاید، مجموع زوج است. نتیجه می‌شود چه در پرتاب دو تاس و چه در پرتاب سه تاس احتمال آن‌که مجموع اعداد زوج باشد با احتمال آن‌که فرد باشد برابر $\\frac{1}{2}$ است. بنابراین:\n$\\frac{P(\\text{مجموع دو تاس زوج باشد})}{P(\\text{مجموع سه تاس زوج باشد})} = \\frac{\\frac{1}{2}}{\\frac{1}{2}} = 1$"}],"smart_shortcut":null,"media_assets":["question_media/math/nardebam_math_1405_1840/option_1_2.webp","question_media/math/nardebam_math_1405_1840/option_2_3.webp","question_media/math/nardebam_math_1405_1840/option_3_4.webp","question_media/math/nardebam_math_1405_1840/option_4_5.webp","question_media/math/nardebam_math_1405_1840/stem_1.webp"],"media_evidence":[{"asset":"question_media/math/nardebam_math_1405_1840/option_1_2.webp","sha256":"9621ccb7e9ebdd5ce1d10d9bf7e7fbb39bbe6b38ec011f86d73ba6467a20f45b","bytes":658},{"asset":"question_media/math/nardebam_math_1405_1840/option_2_3.webp","sha256":"7f0127ec45e72f9ea0d0535fcd4431556715cf8bf7d0503bc095ddae3f611b25","bytes":814},{"asset":"question_media/math/nardebam_math_1405_1840/option_3_4.webp","sha256":"7628b4040cb6523a8d2c0095337f72a9836103a1ec659bbcab488bc8778b93a2","bytes":732},{"asset":"question_media/math/nardebam_math_1405_1840/option_4_5.webp","sha256":"b9a182e5cdace9041861c161593bc6c8628715bfd153fdd95ad1f3d03176acd1","bytes":700},{"asset":"question_media/math/nardebam_math_1405_1840/stem_1.webp","sha256":"aad0bc5bf21fb2d5a18070686d5f6cdaf76c2cfd5db7200b8a674531dc4ecf8e","bytes":5870}],"provenance":{"edition":"nardebam_1405","question_number":1840,"question_pdf":"16.pdf","question_page":11,"solution_page":170,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_math_1405_1841","source_sha256":"5cbb13ba0aa830dbaae2dcdc2e1d82fe7b58c73504cd135495b60c68039db971","subject":"math","section_id":"math_discrete_data","source_topic_key":"probability","source_difficulty":"hard","stem":[{"type":"text","text":"در پرتاب سه تاس احتمال آن‌که حاصل‌ضرب اعداد روشده مضرب ۳ باشد، کدام است؟"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1841/stem_1.webp","alt":"صورت سوال 1841","aspect_ratio":0.0485}],"options":[[{"type":"text","text":"$\\dfrac{1}{9}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1841/option_1_2.webp","alt":"گزینه ۱","aspect_ratio":0.5256}],[{"type":"text","text":"$\\dfrac{2}{3}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1841/option_2_3.webp","alt":"گزینه ۲","aspect_ratio":0.5256}],[{"type":"text","text":"$\\dfrac{8}{27}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1841/option_3_4.webp","alt":"گزینه ۳","aspect_ratio":0.5256}],[{"type":"text","text":"$\\dfrac{19}{27}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1841/option_4_5.webp","alt":"گزینه ۴","aspect_ratio":0.5256}]],"solution":[{"type":"text","text":"اگر حداقل یکی از تاس‌ها مضرب ۳ باشد، حاصل‌ضرب آن‌ها نیز مضرب ۳ است. از روش متمم استفاده می‌کنیم.\n$P(\\text{حداقل یکی از تاس‌ها مضرب ۳ باشد}) = 1 - P(\\text{هیچ‌یک از تاس‌ها مضرب ۳ نباشد})$\n$= 1 - \\frac{4 \\times 4 \\times 4}{6 \\times 6 \\times 6} = 1 - (\\frac{2}{3})^3 = 1 - \\frac{8}{27} = \\frac{19}{27}$"}],"smart_shortcut":null,"media_assets":["question_media/math/nardebam_math_1405_1841/option_1_2.webp","question_media/math/nardebam_math_1405_1841/option_2_3.webp","question_media/math/nardebam_math_1405_1841/option_3_4.webp","question_media/math/nardebam_math_1405_1841/option_4_5.webp","question_media/math/nardebam_math_1405_1841/stem_1.webp"],"media_evidence":[{"asset":"question_media/math/nardebam_math_1405_1841/option_1_2.webp","sha256":"9b66cade3352cb161de462bdcab273baafa9cba2d5d4a3e7741c93464cf20596","bytes":832},{"asset":"question_media/math/nardebam_math_1405_1841/option_2_3.webp","sha256":"1050291136c4dbb7c47e0db919ed9d281ddb517636c2a5485901e10adb1cea0f","bytes":896},{"asset":"question_media/math/nardebam_math_1405_1841/option_3_4.webp","sha256":"620c21238fb8846553375f588a980145317c127f05c7fedef7977b33cd2e9944","bytes":1072},{"asset":"question_media/math/nardebam_math_1405_1841/option_4_5.webp","sha256":"488752d9a57d24c52ddc1298f685c879ed2902c76f5fdd759bd3e873b2e7b2a7","bytes":852},{"asset":"question_media/math/nardebam_math_1405_1841/stem_1.webp","sha256":"127d9010e427c3ef4b8c46e1665f5a9845328e4b97987b8721270b8472e30438","bytes":4046}],"provenance":{"edition":"nardebam_1405","question_number":1841,