nardebam_math_1405_1851/option_3_4.webp","question_media/math/nardebam_math_1405_1851/option_4_5.webp","question_media/math/nardebam_math_1405_1851/stem_1.webp"],"media_evidence":[{"asset":"question_media/math/nardebam_math_1405_1851/option_1_2.webp","sha256":"c633fc0b2ba238699937b9afad4572d3aded678e8b0838f04d54824f853a4a18","bytes":1490},{"asset":"question_media/math/nardebam_math_1405_1851/option_2_3.webp","sha256":"c8b4cf469fb85bf0e183541e6ed8e5ab446b25e7b07211df4ef56021cf373156","bytes":1478},{"asset":"question_media/math/nardebam_math_1405_1851/option_3_4.webp","sha256":"2d13eda1cf4d19c907e0c3a4cd1cc65ae28fba76c54e42d8840fa7f3d919d8e4","bytes":936},{"asset":"question_media/math/nardebam_math_1405_1851/option_4_5.webp","sha256":"e56e6beb9fe0f2411f18fd66090b488f97448167b077a09acffab64a3706616b","bytes":1098},{"asset":"question_media/math/nardebam_math_1405_1851/stem_1.webp","sha256":"22a364b75b32f3edf52c7a82b5e07ee45d1d8a1464f064bc0b5aca316833ee4f","bytes":7984}],"provenance":{"edition":"nardebam_1405","question_number":1851,"question_pdf":"16.pdf","question_page":11,"solution_page":171,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_math_1405_1852","source_sha256":"f39ba76edab0a36fb676d846a74d85fa5ccb738ef87be955e4ccdda1bafc4063","subject":"math","section_id":"math_discrete_data","source_topic_key":"probability","source_difficulty":"hard","stem":[{"type":"text","text":"درون یک جعبه ۵ مهرهٔ سفید، ۴ مهرهٔ سیاه و ۳ مهرهٔ قرمز قرار گرفته است. به تصادف ۳ مهره خارج می‌کنیم، به کدام احتمال بین مهره‌های خارج‌شده مهرهٔ سفید نیست یا مهرهٔ قرمز نیست؟"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1852/stem_1.webp","alt":"صورت سوال 1852","aspect_ratio":0.0423}],"options":[[{"type":"text","text":"$\\dfrac{119}{220}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1852/option_1_2.webp","alt":"گزینه ۱","aspect_ratio":0.5256}],[{"type":"text","text":"$\\dfrac{9}{22}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1852/option_2_3.webp","alt":"گزینه ۲","aspect_ratio":0.5256}],[{"type":"text","text":"$\\dfrac{23}{44}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1852/option_3_4.webp","alt":"گزینه ۳","aspect_ratio":0.5256}],[{"type":"text","text":"$\\dfrac{13}{22}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1852/option_4_5.webp","alt":"گزینه ۴","aspect_ratio":0.5256}]],"solution":[{"type":"text","text":"پیشامد آن‌که بین مهره‌های خارج‌شده مهره سفید نباشد را $A$ و پیشامد آن‌که مهره قرمز نباشد را $B$ می‌نامیم.\\n$P(A \\cup B) = \\frac{n(A \\cup B)}{n(S)} = \\frac{n(A) + n(B) - n(A \\cap B)}{n(S)}$\\n$= \\frac{\\binom{7}{3} + \\binom{9}{3} - \\binom{4}{3}}{\\binom{12}{3}} = \\frac{35 + 84 - 4}{220} = \\frac{115}{220} = \\frac{23}{44}$"}],"smart_shortcut":null,"media_assets":["question_media/math/nardebam_math_1405_1852/option_1_2.webp","question_media/math/nardebam_math_1405_1852/option_2_3.webp","question_media/math/nardebam_math_1405_1852/option_3_4.webp","question_media/math/nardebam_math_1405_1852/option_4_5.webp","question_media/math/nardebam_math_1405_1852/stem_1.webp"],"media_evidence":[{"asset":"question_media/math/nardebam_math_1405_1852/option_1_2.webp","sha256":"8e199b2e1b7a843195f252efb54ecb46f3980b13eecbcbc03a37c48e7cf92fab","bytes":2122},{"asset":"question_media/math/nardebam_math_1405_1852/option_2_3.webp","sha256":"727ab444fd2e4de7206035b7ee81aa84063e3f48e86f80755079b101d22f7266","bytes":1532},{"asset":"question_media/math/nardebam_math_1405_1852/option_3_4.webp","sha256":"3b224f25101891802f58f7c9465f55f0415b8b978efacdc0460c1e9b25a0d4a1","bytes":1608},{"asset":"question_media/math/nardebam_math_1405_1852/option_4_5.webp","sha256":"b5bfeeffe71a25112d3d66d3932ee47d6fc52b8a0252e5929f599bed9fc79793","bytes":820},{"asset":"question_media/math/nardebam_math_1405_1852/stem_1.webp","sha256":"13852c20e098128d3f9ef813e0b36499d5814c0bcb56477a112ffa6a19c136e2","bytes":11528}],"provenance":{"edition":"nardebam_1405","question_number":1852,"question_pdf":"16.pdf","question_page":11,"solution_page":171,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_math_1405_1853","source_sha256":"96e0bb27834e791bb9693616d5933053716479e9c10a1eeea56d6e3b261486bf","subject":"math","section_id":"math_discrete_data","source_topic_key":"probability","source_difficulty":"hard","stem":[{"type":"text","text":"در ظرفی سه مهرهٔ سیاه و n مهرهٔ قرمز داریم. مهره‌ای به تصادف خارج می‌کنیم، به احتمال $\\dfrac{1}{4}$ مهره سیاه است. اگر دو مهره با هم خارج می‌کردیم، به کدام احتمال هر ۲ مهره هم‌رنگ می‌شد؟"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1853/stem_1.webp","alt":"صورت سوال 1853","aspect_ratio":0.0457}],"options":[[{"type":"text","text":"$\\dfrac{11}{22}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1853/option_1_2.webp","alt":"گزینه ۱","aspect_ratio":0.5256}],[{"type":"text","text":"$\\dfrac{13}{22}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1853/option_2_3.webp","alt":"گزینه ۲","aspect_ratio":0.5256}],[{"type":"text","text":"$\\dfrac{15}{22}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1853/option_3_4.webp","alt":"گزینه ۳","aspect_ratio":0.5256}],[{"type":"text","text":"$\\dfrac{17}{22}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1853/option_4_5.webp","alt":"گزینه ۴","aspect_ratio":0.5256}]],"solution":[{"type":"text","text":"ابتدا $n$ را به دست می‌آوریم:\\n$P(\\text{سیاه}) = \\frac{n(\\text{سیاه})}{n(S)} \\Rightarrow \\frac{3}{n+3} = \\frac{1}{4} \\Rightarrow n+3 = 12 \\Rightarrow n=9$\\nحال احتمال هم‌رنگ‌بودن ۲ مهره را محاسبه می‌کنیم. یا هر دو مهره سیاه هستند و یا قرمز:\\n$P(A) = \\frac{\\binom{3}{2} + \\binom{9}{2}}{\\binom{12}{2}} = \\frac{3 + 36}{66} = \\frac{39}{66} = \\frac{13}{22}$"}],"smart_shortcut":null,"media_assets":["question_media/math/nardebam_math_1405_1853/option_1_2.webp","question_media/math/nardebam_math_1405_1853/option_2_3.webp","question_media/math/nardebam_math_1405_1853/option_3_4.webp","question_media/math/nardebam_math_1405_1853/option_4_5.webp","question_media/math/nardebam_math_1405_1853/stem_1.webp"],"media_evidence":[{"asset":"question_media/math/nardebam_math_1405_1853/option_1_2.webp","sha256":"9ac018a08d79de9fdbe4caa153ba357ef411d3a57f192f339eee8efd22e9f259","bytes":1050},{"asset":"question_media/math/nardebam_math_1405_1853/option_2_3.webp","sha256":"187fd243b921377a16a90420e19b6896ba7279a2464f6e7cee7152b36357d25a","bytes":1086},{"asset":"question_media/math/nardebam_math_1405_1853/option_3_4.webp","sha256":"05b2db82b5fb9271cfd4e1bd57a6f4f6532c6041f7d7093507cc621133e6c6fa","bytes":1154},{"asset":"question_media/math/nardebam_math_1405_1853/option_4_5.webp","sha256":"e6d16f253306fc97e6e2d2a74e602a366ab1368fdfc3f6e4f2eb443d9f0a64f7","bytes":642},{"asset":"question_media/math/nardebam_math_1405_1853/stem_1.webp","sha256":"e01fe361221ffd9b39d54bfd811df3492f703e3956c3ae9748e2548369593eab","bytes":24264}],"provenance":{"edition":"nardebam_1405","question_number":1853,"question_pdf":"16.pdf","question_page":11,"solution_page":171,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_math_1405_1854","source_sha256":"29ed11e3910bdfafad6cbe752870c1fdc09c8ca37cae672597099339df61f783","subject":"math","section_id":"math_discrete_data","source_topic_key":"probability","source_difficulty":"hard","stem":[{"type":"text","text":"در یک کیسه ۶ مهرهٔ قرمز و ۴ مهرهٔ آبی موجود است. در انتخاب تصادفی سه مهره با چه احتمالی هر دو رنگ موجود است؟"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1854/stem_1.webp","alt":"صورت سوال ۱۸۵۴","aspect_ratio":0.0619}],"options":[[{"type":"text","text":"$\\frac{1}{5}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1854/option_1_2.webp","alt":"گزینه ۱","aspect_ratio":0.7179}],[{"type":"text","text":"$\\frac{2}{5}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1854/option_2_3.webp","alt":"گزینه ۲","aspect_ratio":0.7778}],[{"type":"text","text":"$\\frac{3}{5}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1854/option_3_4.webp","alt":"گزینه ۳","aspect_ratio":0.9492}],[{"type":"text","text":"$\\frac{4}{5}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1854/option_4_5.webp","alt":"گزینه ۴","aspect_ratio":0.7778}]],"solution":[{"type":"text","text":"روش اول: باید یک مهره قرمز و دو مهره آبی و یا دو مهره قرمز و یک مهره آبی باشد.\\n$P(A) = \\frac{\\binom{6}{1}\\binom{4}{2} + \\binom{6}{2}\\binom{4}{1}}{\\binom{10}{3}} = \\frac{36 + 60}{120} = \\frac{96}{120} = \\frac{4}{5}$\\nروش دوم: روش متمم:\\n$P(A) = 1 - P(A') = 1 - \\frac{\\binom{4}{3}_{\\text{هر سه آبی}} + \\binom{6}{3}_{\\text{هر سه قرمز}}}{\\binom{10}{3}} = 1 - \\frac{4 + 20}{120} = 1 - \\frac{24}{120} = 1 - \\frac{1}{5} = \\frac{4}{5}$"}],"smart_shortcut":null,"media_assets":["question_media/math/nardebam_math_1405_1854/option_1_2.webp","question_media/math/nardebam_math_1405_1854/option_2_3.webp","question_media/math/nardebam_math_1405_1854/option_3_4.webp","question_media/math/nardebam_math_1405_1854/option_4_5.webp","question_media/math/nardebam_math_1405_1854/stem_1.webp"],"media_evidence":[{"asset":"question_media/math/nardebam_math_1405_1854/option_1_2.webp","sha256":"5f64c4805be153214f4354fb57cabfbae7fa5277d2bf4c451aa2288c4e18b33f","bytes":80},{"asset":"question_media/math/nardebam_math_1405_1854/option_2_3.webp","sha256":"a0a73290593557557a6d0ff8d5431e5d3a0458a9802b2b62e35f4bcb3eef3e4b","bytes":424},{"asset":"question_media/math/nardebam_math_1405_1854/option_3_4.webp","sha256":"574a6f45547d77f4264d17a452bd7b0797bb81fe09492c28063734d457557437","bytes":724},{"asset":"question_media/math/nardebam_math_1405_1854/option_4_5.webp","sha256":"be8ab2341dc454a01edf98182059981baee21ff393b8de6714249dfe34d8ce73","bytes":1220},{"asset":"question_media/math/nardebam_math_1405_1854/stem_1.webp","sha256":"4c9a3a302daa4bb0c541001be873c05821a3a9ace2d55f5406065c9d31c57331","bytes":4612}],"provenance":{"edition":"nardebam_1405","question_number":1854,"question_pdf":"16.pdf","question_page":12,"solution_page":171,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_math_1405_1855","source_sha256":"a23cedf6c4b5387c6a336784e8fa399a42d410b16ac4c666e8f268a62025e4ec","subject":"math","section_id":"math_discrete_data","source_topic_key":"probability","source_difficulty":"hard","stem":[{"type":"text","text":"در یک کیسه ۸ مهرهٔ قرمز، ۶ مهرهٔ سبز و ۴ مهرهٔ آبی موجود است. با خروج تصادفی ۴ مهره از کیسه با کدام احتمال یک مهره سبز و حداقل ۲ مهره قرمز است؟"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1855/stem_1.webp","alt":"صورت سوال ۱۸۵۵","aspect_ratio":0.0902}],"options":[[{"type":"text","text":"$\\frac{28}{85}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1855/option_1_2.webp","alt":"گزینه ۱","aspect_ratio":1.4068}],[{"type":"text","text":"$\\frac{6}{17}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1855/option_2_3.webp","alt":"گزینه ۲","aspect_ratio":1.4068}],[{"type":"text","text":"$\\frac{32}{85}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1855/option_3_4.webp","alt":"گزینه ۳","aspect_ratio":1.4068}],[{"type":"text","text":"$\\frac{2}{5}$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_1855/option_4_5.webp","alt":"گزینه ۴","aspect_ratio":1.3833}]],"solution":[{"type":"text","text":"یا ۱ مهره سبز، ۲ مهره قرمز و ۱ مهره آبی و یا ۱ مهره سبز و ۳ مهره قرمز است.\n$P(A) = \\frac{\\binom{5}{1} \\binom{8}{2} \\binom{4}{1} + \\binom{5}{1} \\binom{8}{3}}{\\binom{18}{4}} = \\frac{(5 \\times 28 \\times 4) + (5 \\times 56)}{\\frac{18 \\times 17 \\times 16 \\times 15}{4!}} = \\frac{5 \\times 56 \\times 3 \\times 4!}{18 \\times 17 \\times 16 \\times 15} = \\frac{7 \\times 4}{17 \\times 5} = \\frac{28}{85}$"}],"smart_shortcut":null,"media_assets":["question_media/math/nardebam_math_1405_1855/option_1_2.webp","question_media/mat