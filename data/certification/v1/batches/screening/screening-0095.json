ebam_math_1405_2001/option_3_4.webp","sha256":"6d55a2839bb2e635bd3a755829af05af14942fa69bd09c5cec171e96510180da","bytes":3022},{"asset":"question_media/math/nardebam_math_1405_2001/option_4_5.webp","sha256":"06d68fe621a28d66be75cf62a33576b439d41293690596271d0f652f03554ad8","bytes":2324},{"asset":"question_media/math/nardebam_math_1405_2001/stem_1.webp","sha256":"b25aa8bca4fa05164c214a0b58df2dfe75c26fe7521f09087ae5aece07c5e47d","bytes":7988}],"provenance":{"edition":"nardebam_1405","question_number":2001,"question_pdf":"18.pdf","question_page":5,"solution_page":186,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_math_1405_2002","source_sha256":"60df453bf7ff77f77aad7737fe45c8ecbcb56d6f3626804d7ac09969b1861ce3","subject":"math","section_id":"math_discrete_data","source_topic_key":"statistics","source_difficulty":"hard","stem":[{"type":"text","text":"از بین داده‌های $۷,۶,۳,۵,۴,۶,۴$ کدام عدد را حذف کنیم تا میانگین داده‌ها بدون تغییر باقی بماند؟"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2002/stem_1.webp","alt":"صورت سوال ۲۰۰۲","aspect_ratio":11.9205}],"options":[[{"type":"text","text":"$۳$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2002/option_1_2.webp","alt":"گزینه ۱","aspect_ratio":0.9024}],[{"type":"text","text":"$۴$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2002/option_2_3.webp","alt":"گزینه ۲","aspect_ratio":0.878}],[{"type":"text","text":"$۵$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2002/option_3_4.webp","alt":"گزینه ۳","aspect_ratio":0.878}],[{"type":"text","text":"$۶$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2002/option_4_5.webp","alt":"گزینه ۴","aspect_ratio":0.878}]],"solution":[{"type":"text","text":"ابتدا میانگین داده‌ها را حساب می‌کنیم:\n$\\overline{x} = \\frac{7+6+3+5+4+6+4}{7} = \\frac{35}{7} = 5$\nبا حذف ۱ داده، میانگین ۶ دادهٔ باقی‌مانده باید برابر ۵ باشد، یعنی جمع اعداد باقی‌مانده برابر $30 = 6 \\times 5$ است. جمع ۷ عدد اولیه ۳۵ می‌باشد، بنابراین عدد ۵ حذف شده است. در واقع اگر با حذف ۱ عدد میانگین تغییر نکند، آن عدد برابر میانگین است."}],"smart_shortcut":null,"media_assets":["question_media/math/nardebam_math_1405_2002/option_1_2.webp","question_media/math/nardebam_math_1405_2002/option_2_3.webp","question_media/math/nardebam_math_1405_2002/option_3_4.webp","question_media/math/nardebam_math_1405_2002/option_4_5.webp","question_media/math/nardebam_math_1405_2002/stem_1.webp"],"media_evidence":[{"asset":"question_media/math/nardebam_math_1405_2002/option_1_2.webp","sha256":"8bfd98c074f469cc94e154e7ae53f589fbd5afd8da4417acd78b3d16cc638da3","bytes":1422},{"asset":"question_media/math/nardebam_math_1405_2002/option_2_3.webp","sha256":"8b8d743f631629e79b5f6f46d34a457a5197ddb5d7d40e5b888fc73033efbfc1","bytes":606},{"asset":"question_media/math/nardebam_math_1405_2002/option_3_4.webp","sha256":"75b8692b1737fd536b759cd1650cbdeb9b6f98263c5e4369111730e45e9964bc","bytes":812},{"asset":"question_media/math/nardebam_math_1405_2002/option_4_5.webp","sha256":"c8b59e96daa51ec51eec4f08b9e43a4bab9229a0aeabb7bee4415a340444bfd4","bytes":656},{"asset":"question_media/math/nardebam_math_1405_2002/stem_1.webp","sha256":"76c7490d236831cd30c570d3b15a9bbdb933ee174a637dd03d17853ae7405c67","bytes":4712}],"provenance":{"edition":"nardebam_1405","question_number":2002,"question_pdf":"18.pdf","question_page":5,"solution_page":186,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_math_1405_2003","source_sha256":"67106caf830429d66128b5c4599fad841e94717183afb820e24902aedcf30769","subject":"math","section_id":"math_discrete_data","source_topic_key":"statistics","source_difficulty":"hard","stem":[{"type":"text","text":"میانگین اعداد مثبت $a,۶,۲,۸,۱$ یک واحد از میانهٔ این اعداد بزرگ‌تر است. جمع مقادیر $a$ کدام است؟"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2003/stem_1.webp","alt":"صورت سوال ۲۰۰۳","aspect_ratio":13.1098}],"options":[[{"type":"text","text":"$۱۸$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2003/option_1_2.webp","alt":"گزینه ۱","aspect_ratio":1.0241}],[{"type":"text","text":"$۲۰$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2003/option_2_3.webp","alt":"گزینه ۲","aspect_ratio":1.0361}],[{"type":"text","text":"$۲۱$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2003/option_3_4.webp","alt":"گزینه ۳","aspect_ratio":1.012}],[{"type":"text","text":"$۲۳$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2003/option_4_5.webp","alt":"گزینه ۴","aspect_ratio":1.0602}]],"solution":[{"type":"text","text":"میانگین اعداد برابر است با:\n$\\overline{x} = \\frac{a+17}{5}$\nبا توجه به اعداد $a, 1, 2, 6, 8$ سه حالت دارد:\nالف) $a < 2 \\Rightarrow \\text{میانه} = 2 \\Rightarrow \\overline{x} = 3$\n$\\Rightarrow \\frac{a+17}{5} = 3 \\Rightarrow a = -2 \\text{ ق.ق.غ}$\nب) $2 \\le a \\le 6 \\Rightarrow \\text{میانه} = a \\Rightarrow \\overline{x} = a+1$\n$\\Rightarrow \\frac{a+17}{5} = a+1 \\Rightarrow a=3 \\checkmark$\nپ) $a > 6 \\Rightarrow \\text{میانه} = 6 \\Rightarrow \\overline{x} = 7$\n$\\Rightarrow \\frac{a+17}{5} = 7 \\Rightarrow a=18 \\checkmark$\n$3+18=21 = \\text{مجموع مقادیر } a$"}],"smart_shortcut":null,"media_assets":["question_media/math/nardebam_math_1405_2003/option_1_2.webp","question_media/math/nardebam_math_1405_2003/option_2_3.webp","question_media/math/nardebam_math_1405_2003/option_3_4.webp","question_media/math/nardebam_math_1405_2003/option_4_5.webp","question_media/math/nardebam_math_1405_2003/stem_1.webp"],"media_evidence":[{"asset":"question_media/math/nardebam_math_1405_2003/option_1_2.webp","sha256":"51c320e6b33533111059c0a5299bc41897dff1b7f69c552ec4ef39c80f721545","bytes":2204},{"asset":"question_media/math/nardebam_math_1405_2003/option_2_3.webp","sha256":"303d73718ab2bc41030cf907ebad47544e27780bc9d3dc289458b00f5f5a0fb2","bytes":1390},{"asset":"question_media/math/nardebam_math_1405_2003/option_3_4.webp","sha256":"92522279aa692f2a047cd7ed96629c2663932d6d5795ff3f846b1127472e641f","bytes":620},{"asset":"question_media/math/nardebam_math_1405_2003/option_4_5.webp","sha256":"fa20ad364208752ac862d2cfbeb7966b5c6ddeea68665bfc346af95b3bab0350","bytes":544},{"asset":"question_media/math/nardebam_math_1405_2003/stem_1.webp","sha256":"91abb9b1a313c52ea3c9f8eb2ab96ee431b6a537d4469f7291d0e7a6b8bfffde","bytes":3462}],"provenance":{"edition":"nardebam_1405","question_number":2003,"question_pdf":"18.pdf","question_page":5,"solution_page":186,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_math_1405_2004","source_sha256":"50db943f7bf67a49312588f3e0c1012642712708ca3603f9e4e4111c1c4be649","subject":"math","section_id":"math_discrete_data","source_topic_key":"statistics","source_difficulty":"hard","stem":[{"type":"text","text":"میانگین $n$ داده ۱۲ و میانگین ۱۲ داده $n$ است. اگر میانگین تمام داده‌ها $۹/۶$ باشد، عدد طبیعی $n$ کدام است؟"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2004/stem_1.webp","alt":"صورت سوال ۲۰۰۴","aspect_ratio":13.3882}],"options":[[{"type":"text","text":"$۶$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2004/option_1_2.webp","alt":"گزینه ۱","aspect_ratio":0.8706}],[{"type":"text","text":"$۸$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2004/option_2_3.webp","alt":"گزینه ۲","aspect_ratio":0.8471}],[{"type":"text","text":"$۹$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2004/option_3_4.webp","alt":"گزینه ۳","aspect_ratio":0.8471}],[{"type":"text","text":"$۱۰$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2004/option_4_5.webp","alt":"گزینه ۴","aspect_ratio":1.0118}]],"solution":[{"type":"text","text":"اگر میانگین $n$ داده $\\overline{x}$ و میانگین $m$ داده $\\overline{y}$ باشد، میانگین کل از رابطه زیر محاسبه می‌شود:\n$\\text{میانگین کل} = \\frac{n\\overline{x} + m\\overline{y}}{m+n}$\nبنابراین:\n$\\text{میانگین کل} = \\frac{(n\\times 12)+(12\\times n)}{n+12} = 9/6$\n$\\Rightarrow 24n = 9/6n + 12 \\times 9/6 \\Rightarrow 14/4n = 12 \\times 9/6$\n$\\Rightarrow 144n = 12 \\times 96 \\Rightarrow 12n = 96 \\Rightarrow n=8$"}],"smart_shortcut":null,"media_assets":["question_media/math/nardebam_math_1405_2004/option_1_2.webp","question_media/math/nardebam_math_1405_2004/option_2_3.webp","question_media/math/nardebam_math_1405_2004/option_3_4.webp","question_media/math/nardebam_math_1405_2004/option_4_5.webp","question_media/math/nardebam_math_1405_2004/stem_1.webp"],"media_evidence":[{"asset":"question_media/math/nardebam_math_1405_2004/option_1_2.webp","sha256":"6ad0feb5e920ecda7a76c521d43f0ae304849545233982a56a813735c992221c","bytes":1326},{"asset":"question_media/math/nardebam_math_1405_2004/option_2_3.webp","sha256":"84523187b17411479112574066a6019584679bba9b4c925b82401418ad032ae3","bytes":608},{"asset":"question_media/math/nardebam_math_1405_2004/option_3_4.webp","sha256":"01095bf9bae79ed08d50ee25d9658302a1445285903cf6469a9b826878e3e491","bytes":776},{"asset":"question_media/math/nardebam_math_1405_2004/option_4_5.webp","sha256":"7a388c62769f91b4cddda35faa79b28f8dd0d71ebf846478af2d1b1ee399bf83","bytes":904},{"asset":"question_media/math/nardebam_math_1405_2004/stem_1.webp","sha256":"79b0e902f9d20dbc93c9bbcf3e3d3c9929e60352da99e580bb33362d41097f4a","bytes":4330}],"provenance":{"edition":"nardebam_1405","question_number":2004,"question_pdf":"18.pdf","question_page":5,"solution_page":187,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_math_1405_2005","source_sha256":"09c753b6fdc76ee780fdc2a72ce4bb6d50a4073b520535bdc0b7a8d95cc4f91c","subject":"math","section_id":"math_discrete_data","source_topic_key":"statistics","source_difficulty":"hard","stem":[{"type":"text","text":"کلاس $A$ با میانگین نمرات ۱۰ و کلاس $B$ با میانگین نمرات ۱۲ پس از ادغام با هم، در یک کلاس با میانگین $۱۱/۵$ قرار گرفته‌اند. جمعیت کلاس $B$ چند برابر جمعیت کلاس $A$ است؟"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2005/stem_1.webp","alt":"صورت سوال ۲۰۰۵","aspect_ratio":10.9695}],"options":[[{"type":"text","text":"$۳$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2005/option_1_2.webp","alt":"گزینه ۱","aspect_ratio":0.8706}],[{"type":"text","text":"$۴$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2005/option_2_3.webp","alt":"گزینه ۲","aspect_ratio":0.8471}],[{"type":"text","text":"$۵$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2005/option_3_4.webp","alt":"گزینه ۳","aspect_ratio":0.8471}],[{"type":"text","text":"$۶$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2005/option_4_5.webp","alt":"گزینه ۴","aspect_ratio":0.8471}]],"solution":[{"type":"text","text":"فرض کنیم جمعیت کلاس $\\text{A}$ برابر $n$ و جمعیت کلاس $\\text{B}$ برابر $kn$ باشد:\n$\\text{میانگین کل داده‌ها} = \\overline{x} = \\frac{n\\times 10+kn\\times 12}{n+kn} = \\frac{23}{2}$\n$\\Rightarrow \\frac{10+12k}{k+1} = \\frac{23}{2} \\Rightarrow 20+24k=23k+23 \\Rightarrow k=3$\nجمعیت کلاس $\\text{B}$ سه برابر جمعیت کلاس $\\text{A}$ است.\nنکته: اگر $n$ داده با میانگین $\\overline{x}$ و $m$ داده با میانگین $\\overline{y}$ با هم ادغام شوند، میانگین کل داده‌ها برابر است با:\n$\\frac{n\\overline{x} + m\\overline{y}}{m+n}$"}],"smart_shortcut":null,"media_assets":["question_media/math/nardebam_math_1405_2005/option_1_2.webp","question_media/math/nardebam_math_1405_2005/option_2_3.webp","question_media/math/nardebam_math_1405_2005/option_3_4.webp","question_media/math/nardebam_math_1405_2005/option_4_5.webp","question_media/math/nardebam_math_1405_2005/stem_1.webp"],"media_evidence":[{"asset":"question_media/math/nardebam_math_1405_2005/option_1_2.webp","sha256":"2c891fa9a180e0d0caa8b799e256b8709e4a00a5749b72f30cd6821387ed22f0","bytes":1218},{"asset":"question_media/math/nardebam_math_1405_2005/option_2_3.webp","sha256":"6676747e6fb73418fbb73b89c504b85b9c6bf845b934376d5eea52e9342185e8","bytes":448},{"asset":"question_media/math/nardebam_math_1405_2005/option_3_4.webp","sha256":"679dc0858561bc5e33272c748e91e0fa15c5a2e3b9adf4d280d4cb9662da4a0a","bytes":464},{"asset":"question_media/math/nardebam_math_1405_2005/option_4_5.webp","sha256":"57668d11ee8cf7b2f547b9bde962635eea97dead4045e8fc281e0f6d0df9f8f5","bytes":530},{"asset":"question_media/math/nardebam_math_1405_2005/stem_1.webp","sha256":"3e86945c6eb8be8704ba4fa8e58bd29ff5fb2150023e405f8785a2ea96556a7d","bytes":14226}],"provenance":{"edition":"nardebam_1405","question_number":2005,"question_pdf":"18.pdf","question_page":5,"solution_page":187,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_math_1405_2006","source_sha256":"b1529213d80ac730ec4403dc76eb05aa1668c1b00767369ee9cd00f9debfa6ad","subject":"math","section_id":"math_discrete_data","source_topic_key":"statistics","source_difficulty":"hard","stem":[{"type":"text","text":"میانگین ۱۰ دادهٔ آماری را ۱۲ اعلام کرده‌ایم. بعداً متوجه شده‌ایم در یکی از داده‌ها به جای عدد ۱۶ عدد ۲۶ وارد شده و البته عدد ۱۱ نیز جا مانده بود. میانگین واقعی اعداد کدام است؟"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2006/stem_1.webp","alt":"صورت سوال ۲۰۰۶","aspect_ratio":10.812}],"options":[[{"type":"text","text":"$۱۱/۲۵$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2006/option_1_2.webp","alt":"گزینه ۱","aspect_ratio":1.4878}],[{"type":"text","text":"$۱۱/۲$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2006/option_2_3.webp","alt":"گزینه ۲","aspect_ratio":1.2927}],[{"type":"text","text":"$۱۰/۹$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2006/option_3_4.webp","alt":"گزینه ۳","aspect_ratio":1.2683}],[{"type":"text","text":"$۱۱$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2006/option_4_5.webp","alt":"گزینه ۴","aspect_ratio":1.0488}]],"solution":[{"type":"text","text":"میانگین $10$ دادۀ اولیه برابر $12$ بوده است. بنابراین جمع داده‌ها برابر $120 = 10 \\times 12$ است. با تغییر عدد $26$ به $16$، از مجموع داده‌ها $10$ واحد کاسته شده و با افزودن دادۀ $11$ به مجموع داده‌ها $1$ واحد افزوده شده و تعداد داده‌ها نیز به $11$ افزایش می‌یابد.\n$\\overline{x}_{\\text{جدید}} = \\frac{120 + 1}{11} = \\frac{121}{11} = 11$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2006/solution_6.webp","alt":"Solution for 2006","aspect_ratio":2.6426}],"smart_shortcut":null,"media_assets":["question_media/math/nardebam_math_1405_2006/option_1_2.webp","question_media/math/nardebam_math_1405_2006/option_2_3.webp","question_media/math/nardebam_math_1405_2006/option_3_4.webp","question_media/math/nardebam_math_1405_2006/option_4_5.webp","question_media/math/nardebam_math_1405_2006/solution_6.webp","question_media/math/nardebam_math_1405_2006/stem_1.webp"],"media_evidence":[{"asset":"question_media/math/nardebam_math_1405_2006/option_1_2.webp","sha256":"e246998d434d002cd1f22d54073c77ac1df912c5d2058528b18023c86e12f0c4","bytes":1410},{"asset":"question_media/math/nardebam_math_1405_2006/option_2_3.webp","sha256":"15802f19a7c8fff3e2dfc0cb75c63088c93a6d260f8f53951581d95ddb56f6a9","bytes":1454},{"asset":"question_media/math/nardebam_math_1405_2006/option_3_4.webp","sha256":"be96a6eb25fcca08007aee913d1f9121a2d84dc31827b0d110e306aaac071831","bytes":1478},{"asset":"question_media/math/nardebam_math_1405_2006/option_4_5.webp","sha256":"b29efc23235c0b5c88838431b721f987241b4ae87378449c2e05d4227d453015","bytes":1224},{"asset":"question_media/math/nardebam_math_1405_2006/solution_6.webp","sha256":"5fc6ea4e45def0c880a127b504303aed13793bec338fe60e0880dc4425972193","bytes":19310},{"asset":"question_media/math/nardebam_math_1405_2006/stem_1.webp","sha256":"68c4b1a741577531138e79c0a3894e13a92a25e3701d02e8908b6511d678142b","bytes":17306}],"provenance":{"edition":"nardebam_1405","question_number":2006,"question_pdf":"18.pdf","question_page":5,"solution_page":187,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_math_1405_2007","source_sha256":"5bd2bc6e567580067f6d8a3ab7f1701a717b0e7bf126159b498e05859b9c3eb4","subject":"math","section_id":"math_discrete_data","source_topic_key":"statistics","source_difficulty":"hard","stem":[{"type":"text","text":"میانگین داده‌های $x_1,x_2,\\dots,x_n$ برابر $\\overline{x}$ است. اگر میانگین $۳x_1+\\overline{x},۳x_2+\\overline{x},\\dots,۳x_n+\\overline{x}$ برابر ۴۰ باشد، $\\overline{x}$ چه عددی است؟"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2007/stem_1.webp","alt":"صورت سوال ۲۰۰۷","aspect_ratio":15.2299}],"options":[[{"type":"text","text":"$۱۲$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2007/option_1_2.webp","alt":"گزینه ۱","aspect_ratio":1.0241}],[{"type":"text","text":"$۸$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2007/option_2_3.webp","alt":"گزینه ۲","aspect_ratio":0.8675}],[{"type":"text","text":"$۱۰$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2007/option_3_4.webp","alt":"گزینه ۳","aspect_ratio":1.012}],[{"type":"text","text":"$۱۲/۵$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2007/option_4_5.webp","alt":"گزینه ۴","aspect_ratio":1.3855}]],"solution":[{"type":"text","text":"تمامی داده‌های $x_1, x_2, \\dots, x_n$ در $3$ ضرب و حاصل آن‌ها با عدد ثابت $\\overline{x}$ جمع شده است. بنابراین میانگین این اعداد نیز سه برابر شده و با $\\overline{x}$ جمع می‌شود:\n$\\text{میانگین جدید} = 3\\overline{x}+\\overline{x} = 4\\overline{x} = 40 \\Rightarrow \\overline{x} = 10$"}],"smart_shortcut":null,"media_assets":["question_media/math/nardebam_math_1405_2007/option_1_2.webp","question_media/math/nardebam_math_1405_2007/option_2_3.webp","question_media/math/nardebam_math_1405_2007/option_3_4.webp","question_media/math/nardebam_math_1405_2007/option_4_5.webp","question_media/math/nardebam_math_1405_2007/stem_1.webp"],"media_evidence":[{"asset":"question_media/math/nardebam_math_1405_2007/option_1_2.webp","sha256":"bf48ec6470b4cf689827637252287d346c273722ab60fbaad8fb5bea84e7b68f","bytes":1416},{"asset":"question_media/math/nardebam_math_1405_2007/option_2_3.webp","sha256":"cfd34c6d6452d8b7e6b3a9f88cd96b058fb78f128cd7b4d02c34c42d13e3ec4f","bytes":1192},{"asset":"question_media/math/nardebam_math_1405_2007/option_3_4.webp","sha256":"53cb02c9218ee073ff3e3d31fe8e26e1bec47ade054ece1613837006a5383768","bytes":1280},{"asset":"question_media/math/nardebam_math_1405_2007/option_4_5.webp","sha256":"46955379a0886e40fbc18b843652fcb043db722c7a0b512e447b776b1307ef99","bytes":1814},{"asset":"question_media/math/nardebam_math_1405_2007/stem_1.webp","sha256":"8b02c57843cbba3ab101f175eadc4149b2f256b23156a8eeda27f9c44ee06a71","bytes":21316}],"provenance":{"edition":"nardebam_1405","question_number":2007,"question_pdf":"18.pdf","question_page":5,"solution_page":187,"solution_origin":"source"},"source_answer_hidden":true}]}
