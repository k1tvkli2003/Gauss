$"}],"smart_shortcut":null,"media_assets":["question_media/math/nardebam_math_1405_2011/option_1_2.webp","question_media/math/nardebam_math_1405_2011/option_2_3.webp","question_media/math/nardebam_math_1405_2011/option_3_4.webp","question_media/math/nardebam_math_1405_2011/option_4_5.webp","question_media/math/nardebam_math_1405_2011/stem_1.webp"],"media_evidence":[{"asset":"question_media/math/nardebam_math_1405_2011/option_1_2.webp","sha256":"f2d835cb648c514a44ce6f276bd3f4238ba28d632ca2037cbcdceb5c56050b43","bytes":400},{"asset":"question_media/math/nardebam_math_1405_2011/option_2_3.webp","sha256":"7616bf147ce62e753bc16d94d32ed9b86db2e2021f8ddcdad4ad271760c2ba5c","bytes":68},{"asset":"question_media/math/nardebam_math_1405_2011/option_3_4.webp","sha256":"976bba649da21c6d13624cd3c6fcf3f815a40a6f3f07272911a5e39035ab4f5d","bytes":710},{"asset":"question_media/math/nardebam_math_1405_2011/option_4_5.webp","sha256":"c5c56a37e39221493dc83364a70b663f5b59aba3743db26babda6a53212f5323","bytes":68},{"asset":"question_media/math/nardebam_math_1405_2011/stem_1.webp","sha256":"2b5ab213dcae76548fa4b6975b91f0e65601c26074cad216800c1e8ee2c1cc1e","bytes":6584}],"provenance":{"edition":"nardebam_1405","question_number":2011,"question_pdf":"18.pdf","question_page":5,"solution_page":187,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_math_1405_2012","source_sha256":"219a052adaded687414acc42f0408cc29f5786b612b2b8b75e781d0067bae0e0","subject":"math","section_id":"math_discrete_data","source_topic_key":"statistics","source_difficulty":"hard","stem":[{"type":"text","text":"در داده‌های $۷,۴,۲,۶,۳,۸,۴,۱۶,۱۳,۹,۱۹,۱۰$ میانگین داده‌های بیشتر از چارک سوم و میانگین داده‌های کم‌تر از چارک اول چه‌قدر اختلاف دارند؟"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2012/stem_1.webp","alt":"صورت سوال ۲۰۱۲","aspect_ratio":11.9265}],"options":[[{"type":"text","text":"$۱۲/۵$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2012/option_1_2.webp","alt":"گزینه ۱","aspect_ratio":1.6122}],[{"type":"text","text":"$۱۲$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2012/option_2_3.webp","alt":"گزینه ۲","aspect_ratio":1.2245}],[{"type":"text","text":"$۱۳$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2012/option_3_4.webp","alt":"گزینه ۳","aspect_ratio":1.2041}],[{"type":"text","text":"$۱۳/۵$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2012/option_4_5.webp","alt":"گزینه ۴","aspect_ratio":1.551}]],"solution":[{"type":"text","text":"داده‌ها را مرتب می‌کنیم:\n$2, 3, 4 \\, , \\, 4, 6, 7, 8, 9, 10 \\, , \\, 13, 16, 19$\n$\\downarrow \\, \\, \\, \\, \\, \\, \\, \\, \\, \\downarrow \\, \\, \\, \\, \\, \\, \\, \\, \\, \\downarrow$\n$Q_1 \\, \\, \\, \\, \\, Q_2=\\text{میانه} \\, \\, \\, \\, \\, Q_3$\n$\\text{میانگین داده‌های کمتر از چارک اول} = \\overline{x} = \\frac{2+3+4}{3} = 3$\n$\\text{میانگین داده‌های بیشتر از چارک سوم} = \\overline{y} = \\frac{13+16+19}{3} = 16$\n$\\Rightarrow \\overline{y}-\\overline{x} = 16-3=13$"}],"smart_shortcut":null,"media_assets":["question_media/math/nardebam_math_1405_2012/option_1_2.webp","question_media/math/nardebam_math_1405_2012/option_2_3.webp","question_media/math/nardebam_math_1405_2012/option_3_4.webp","question_media/math/nardebam_math_1405_2012/option_4_5.webp","question_media/math/nardebam_math_1405_2012/stem_1.webp"],"media_evidence":[{"asset":"question_media/math/nardebam_math_1405_2012/option_1_2.webp","sha256":"699b500208721bbe982ed4b37561fe9685298fc064c36460fc032be846633c29","bytes":128},{"asset":"question_media/math/nardebam_math_1405_2012/option_2_3.webp","sha256":"9350b1f7373d3e4856446444519f188c44682881bcf10dc717b287d977d97d5a","bytes":88},{"asset":"question_media/math/nardebam_math_1405_2012/option_3_4.webp","sha256":"e482b88377d98f2f1fec80cdc4e2e59b63e8ea76e54c08edf5426afc65b443dd","bytes":88},{"asset":"question_media/math/nardebam_math_1405_2012/option_4_5.webp","sha256":"aebdfe2c3f501870bf5d76528320a816fb5593eedb1820a679c0d614d75ebd7f","bytes":68},{"asset":"question_media/math/nardebam_math_1405_2012/stem_1.webp","sha256":"366489fbd00d6817b28378adaf050f9d6ec98a12d79ee843324499b106c5fd40","bytes":6084}],"provenance":{"edition":"nardebam_1405","question_number":2012,"question_pdf":"18.pdf","question_page":5,"solution_page":187,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_math_1405_2013","source_sha256":"610f25c2c15b975952122489503d9bfbc4b22091a49f5fda640a14cffe0b5838","subject":"math","section_id":"math_discrete_data","source_topic_key":"statistics","source_difficulty":"hard","stem":[{"type":"text","text":"تعداد داده‌های متمایز چه عددی باشد تا چارک اول و سوم در بین داده‌ها باشد اما میانهٔ داده‌ها در بین داده‌ها نباشد؟"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2013/stem_1.webp","alt":"صورت سوال ۲۰۱۳","aspect_ratio":14.1875}],"options":[[{"type":"text","text":"۶۴"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2013/option_1_2.webp","alt":"گزینه ۱","aspect_ratio":1.0816}],[{"type":"text","text":"۶۵"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2013/option_2_3.webp","alt":"گزینه ۲","aspect_ratio":1.0612}],[{"type":"text","text":"۶۶"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2013/option_3_4.webp","alt":"گزینه ۳","aspect_ratio":1.0612}],[{"type":"text","text":"۶۷"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2013/option_4_5.webp","alt":"گزینه ۴","aspect_ratio":1.2245}]],"solution":[{"type":"text","text":"اگر $n$ تعداد داده‌ها و $k$ عددی صحیح باشد، خواهیم داشت:\nهیچ‌یک از چارک‌ها جزء داده‌ها نیستند: $n=4k$\nمیانه جزء داده‌ها بوده ولی چارک اول و سوم جزء داده‌ها نیستند: $n=4k+1$\nمیانه جزء داده‌ها نبوده ولی چارک اول و سوم جزء داده‌ها هستند: $n=4k+2$\nهر سه چارک جزء داده‌ها هستند: $n=4k+3$\n$n$ باید به صورت $4k+2$ باشد، بنابراین عدد $66$ قابل قبول است:\n$66 = 4 \\times 16 + 2$"},{"type":"image","asset":"question_media/math/nardebam_math_1405_2013/solution_6.webp","alt":"Solution for 2013","aspect_ratio":1.9352}],"smart_shortcut":null,"media_assets":["question_media/math/nardebam_math_1405_2013/option_1_2.webp","question_media/math/nardebam_math_1405_2013/option_2_3.webp","question_media/math/nardebam_math_1405_2013/option_3_4.webp","question_media/math/nardebam_math_1405_2013/option_4_5.webp","question_media/math/nardebam_math_1405_2013/solution_6.webp","question_media/math/nardebam_math_1405_2013/stem_1.webp"],"media_evidence":[{"asset":"question_media/math/nardebam_math_1405_2013/option_1_2.webp","sha256":"3c68719869897927a6c961b16d486fabe505a15a364b2621c93912e11cd70e3c","bytes":84},{"asset":"question_media/math/nardebam_math_1405_2013/option_2_3.webp","sha256":"8a0d13b4b0b5aca18613c6cf7a1fc954296c59c54efc4eb64add107f2cf71d8c","bytes":64},{"asset":"question_media/math/nardebam_math_1405_2013/option_3_4.webp","sha256":"30c83537ff4118fc1aecb0f915c49da08fc962f844830b2053fe337b6b6a3990","bytes":406},{"asset":"question_media/math/nardebam_math_1405_2013/option_4_5.webp","sha256":"54c85070eb1741924a2b200e4337683cd5fd98a043f89901fabd6d1a6b99139e","bytes":64},{"asset":"question_media/math/nardebam_math_1405_2013/solution_6.webp","sha256":"0a3e9176175939075aa8873de22370dc10c76052b348b35ecb0c5584de665467","bytes":30086},{"asset":"question_media/math/nardebam_math_1405_2013/stem_1.webp","sha256":"d67fa83996c2c9ae7eeea6cb7d21720b11c9c34cc140c38130c9dfe814aaec47","bytes":446}],"provenance":{"edition":"nardebam_1405","question_number":2013,"question_pdf":"18.pdf","question_page":5,"solution_page":187,"solution_origin":"source"},"source_answer_hidden":true}]}
