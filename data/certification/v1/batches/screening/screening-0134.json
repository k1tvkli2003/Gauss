40},{"asset":"question_media/physics/nardebam_physics_1405_0664/stem_1.webp","sha256":"1ac97e97818db91de7b63efe2e12fd44fbe61d3f5139af199b99b5cd80a005fe","bytes":10374}],"provenance":{"edition":"nardebam_1405","question_number":664,"question_pdf":"6.pdf","question_page":17,"solution_page":330,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_physics_1405_0665","source_sha256":"eac749e3305e746e6a230ff11ba3283dab2bf7b98538d162633379fdfbd4cbe1","subject":"physics","section_id":"physics_fields_circuits","source_topic_key":"current_electricity","source_difficulty":"hard","stem":[{"type":"text","text":"در مدار شکل روبه‌رو، بیشترین توان مصرفی در بین مقاومت‌های خارجی $124$ وات بزرگ‌تر از کم‌ترین توان مصرفی در بین آن مقاومت‌ها می‌باشد. توان خروجی باتری در این مدار چند وات است؟"},{"type":"image","asset":"question_media/physics/nardebam_physics_1405_0665/stem_1.webp","alt":"مدار الکتریکی با باتری و چند مقاومت سری و موازی","aspect_ratio":0.3023}],"options":[[{"type":"text","text":"$180$"}],[{"type":"text","text":"$216$"}],[{"type":"text","text":"$252$"}],[{"type":"text","text":"$288$"}]],"solution":[{"type":"text","text":"با نام‌گذاری نقاط هم‌پتانسیل، R2 و R3 سری شده و معادلشان 12Ω است؛ این شاخه با R4 و R1 موازی می‌شود و Req=2Ω. چون ولتاژ هر شاخه ثابت است، بیشترین توان در کمترین مقاومت و کمترین توان در بزرگ‌ترین شاخه مصرف می‌شود. از تقسیم جریان، جریان شاخه‌ها به دست آمده و اختلاف توان‌ها برای تعیین جریان کل استفاده می‌شود."},{"type":"image","asset":"question_media/physics/nardebam_physics_1405_0665/solution_2.webp","alt":"ساده‌سازی مدار و مقایسه توان شاخه‌های موازی","aspect_ratio":1.2149},{"type":"image","asset":"question_media/physics/nardebam_physics_1405_0665/solution_3.webp","alt":"ادامه محاسبه جریان کل و توان خروجی","aspect_ratio":1.3133}],"smart_shortcut":null,"media_assets":["question_media/physics/nardebam_physics_1405_0665/solution_2.webp","question_media/physics/nardebam_physics_1405_0665/solution_3.webp","question_media/physics/nardebam_physics_1405_0665/stem_1.webp"],"media_evidence":[{"asset":"question_media/physics/nardebam_physics_1405_0665/solution_2.webp","sha256":"47bddead6bf4c85d785bd3a42585a74be0d82210ed3040739906ecc507a206eb","bytes":36484},{"asset":"question_media/physics/nardebam_physics_1405_0665/solution_3.webp","sha256":"815374066e6bd5ed964a292f456394ac7dd95dc77bc02fe8f448123b4c7a5195","bytes":142722},{"asset":"question_media/physics/nardebam_physics_1405_0665/stem_1.webp","sha256":"b22a170411277fd86159c3ec995261ecacb5150189df0c55587e88e3c55aa80e","bytes":6090}],"provenance":{"edition":"nardebam_1405","question_number":665,"question_pdf":"6.pdf","question_page":17,"solution_page":330,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_physics_1405_0666","source_sha256":"d78e7c2dbdc95b40f0913b60b1c5a6d9f3cdff8b47ae9fab56b87d966f933043","subject":"physics","section_id":"physics_fields_circuits","source_topic_key":"current_electricity","source_difficulty":"hard","stem":[{"type":"text","text":"در مدار شکل روبه‌رو، توان مصرفی مقاومت $24$ اهمی چند وات است؟"},{"type":"image","asset":"question_media/physics/nardebam_physics_1405_0666/stem_1.webp","alt":"مدار الکتریکی با منبع ولتاژ ۱۵ ولت و چند مقاومت","aspect_ratio":0.4273}],"options":[[{"type":"text","text":"$\\frac{8}{3}$"}],[{"type":"text","text":"$\\frac{16}{3}$"}],[{"type":"text","text":"$4$"}],[{"type":"text","text":"$8$"}]],"solution":[{"type":"text","text":"مدار دوباره رسم و موازی‌های R2 با R4 و R3 با R5 به ترتیب 4Ω و 8Ω جایگزین می‌شوند. این دو سری و سپس با R1 موازی‌اند، پس Req=4Ω، جریان کل 3A و ولتاژ خروجی 12V است. از تقسیم ولتاژ روی شاخه بالایی، V35=8V و توان مقاومت 24Ω برابر 8/3W به دست می‌آید."},{"type":"image","asset":"question_media/physics/nardebam_physics_1405_0666/solution_2.webp","alt":"مدار اصلی و مدار ساده‌شده برای محاسبه توان مقاومت 24 اهم","aspect_ratio":0.7222}],"smart_shortcut":null,"media_assets":["question_media/physics/nardebam_physics_1405_0666/solution_2.webp","question_media/physics/nardebam_physics_1405_0666/stem_1.webp"],"media_evidence":[{"asset":"question_media/physics/nardebam_physics_1405_0666/solution_2.webp","sha256":"94fdb5aeda48336b00757d9d4237972e7a1ae6edccc44b1fbafbc608fdf9caac","bytes":62502},{"asset":"question_media/physics/nardebam_physics_1405_0666/stem_1.webp","sha256":"083b6160531750d22474e43299a2d6f364c605cece40d359afd9ba641b7eeefe","bytes":4072}],"provenance":{"edition":"nardebam_1405","question_number":666,"question_pdf":"6.pdf","question_page":17,"solution_page":331,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_physics_1405_0667","source_sha256":"9e831b41ea3ed23c1fd434709c434a3669373986f232ac45980897712923aef9","subject":"physics","section_id":"physics_fields_circuits","source_topic_key":"current_electricity","source_difficulty":"hard","stem":[{"type":"text","text":"در مدار شکل روبه‌رو، با حرکت لغزندهٔ رئوستا به سمت راست، مقادیر ولت‌سنج آرمانی و آمپرسنج آرمانی به ترتیب از راست به چپ چگونه تغییر می‌کنند؟"},{"type":"image","asset":"question_media/physics/nardebam_physics_1405_0667/stem_1.webp","alt":"مدار الکتریکی با رئوستا، آمپرسنج و ولت‌سنج","aspect_ratio":0.3763}],"options":[[{"type":"text","text":"افزایش، افزایش"}],[{"type":"text","text":"افزایش، کاهش"}],[{"type":"text","text":"کاهش، افزایش"}],[{"type":"text","text":"کاهش، کاهش"}]],"solution":[{"type":"text","text":"با حرکت لغزنده به راست، طول مؤثر سیم رئوستا در مسیر جریان کمتر و مقاومت رئوستا کاهش می‌یابد. بنابراین جریان مدار افزایش می‌یابد و از رابطه V=ε-rI اختلاف پتانسیل دو سر منبع کاهش پیدا می‌کند."}],"smart_shortcut":null,"media_assets":["question_media/physics/nardebam_physics_1405_0667/stem_1.webp"],"media_evidence":[{"asset":"question_media/physics/nardebam_physics_1405_0667/stem_1.webp","sha256":"729f7122628f641aeca27880b946dfb0e784204ef32672eb3c7d2291db767724","bytes":8042}],"provenance":{"edition":"nardebam_1405","question_number":667,"question_pdf":"6.pdf","question_page":17,"solution_page":331,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_physics_1405_0668","source_sha256":"b55104e9a660402f35bd42e77f533cb6a1dfd3d41fb30ca837466ccca47be409","subject":"physics","section_id":"physics_fields_circuits","source_topic_key":"current_electricity","source_difficulty":"hard","stem":[{"type":"text","text":"در مدار روبه‌رو، اگر مقاومت $R_s$ را افزایش دهیم، اعدادی که آمپرسنج آرمانی و ولت‌سنج آرمانی نشان می‌دهند، به ترتیب از راست به چپ چگونه تغییر می‌کنند؟"},{"type":"image","asset":"question_media/physics/nardebam_physics_1405_0668/stem_1.webp","alt":"مدار الکتریکی با مقاومت متغیر Rs، آمپرسنج و ولت‌سنج","aspect_ratio":0.4298}],"options":[[{"type":"text","text":"افزایش، افزایش"}],[{"type":"text","text":"افزایش، کاهش"}],[{"type":"text","text":"کاهش، افزایش"}],[{"type":"text","text":"کاهش، کاهش"}]],"solution":[{"type":"text","text":"با افزایش مقاومت Rs، مقاومت معادل خارجی مدار زیاد می‌شود، پس جریان کل کاهش می‌یابد. چون V=ε-rI است، با کاهش I عدد ولت‌سنج دو سر باتری افزایش پیدا می‌کند."},{"type":"image","asset":"question_media/physics/nardebam_physics_1405_0668/solution_2.webp","alt":"مدار دارای مقاومت متغیر Rs، آمپرسنج و ولت‌سنج دو سر باتری","aspect_ratio":1.1786}],"smart_shortcut":null,"media_assets":["question_media/physics/nardebam_physics_1405_0668/solution_2.webp","question_media/physics/nardebam_physics_1405_0668/stem_1.webp"],"media_evidence":[{"asset":"question_media/physics/nardebam_physics_1405_0668/solution_2.webp","sha256":"6f127540d425ced6d4236749d802cd6dae8b2707bb30c4c88b1602f27cded30b","bytes":16352},{"asset":"question_media/physics/nardebam_physics_1405_0668/stem_1.webp","sha256":"b530dbb9c80053cf1b26f8f3b39de9e41c2f191ebd9e1159cbdc92c01a730ff8","bytes":6792}],"provenance":{"edition":"nardebam_1405","question_number":668,"question_pdf":"6.pdf","question_page":17,"solution_page":331,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_physics_1405_0669","source_sha256":"2e98c804c86b3c0009e5906ab1d8f7d08334393f392f0c917c0b226f059e531c","subject":"physics","section_id":"physics_fields_circuits","source_topic_key":"current_electricity","source_difficulty":"hard","stem":[{"type":"text","text":"در شکل روبه‌رو، در صورت روشن‌کردن شمع، روشنایی لامپ‌های $L_1$ و $L_2$ به ترتیب از راست به چپ چگونه تغییر می‌کنند؟"},{"type":"image","asset":"question_media/physics/nardebam_physics_1405_0669/stem_1.webp","alt":"مدار الکتریکی با دو لامپ، گرافیت و شمع","aspect_ratio":0.5141}],"options":[[{"type":"text","text":"کاهش، کاهش"}],[{"type":"text","text":"کاهش، افزایش"}],[{"type":"text","text":"افزایش، کاهش"}],[{"type":"text","text":"افزایش، افزایش"}]],"solution":[{"type":"text","text":"کاهش مقاومت گرافیت با افزایش دما باعث کاهش Req و افزایش جریان می‌شود. جریان افزوده از L1 عبور کرده و توان آن افزایش می‌یابد؛ اما با نزدیک شدن گرافیت به اتصال کوتاه، اختلاف پتانسیل روی L2 و توان آن کاهش می‌یابد."},{"type":"image","asset":"question_media/physics/nardebam_physics_1405_0669/solution_2.webp","alt":"مدار دو لامپ با مقاومت گرافیتی موازی با L2","aspect_ratio":0.5493}],"smart_shortcut":null,"media_assets":["question_media/physics/nardebam_physics_1405_0669/solution_2.webp","question_media/physics/nardebam_physics_1405_0669/stem_1.webp"],"media_evidence":[{"asset":"question_media/physics/nardebam_physics_1405_0669/solution_2.webp","sha256":"14484426be437350176bd927351c72904ddaf2e9227c840fbd5ddecf6a784a3e","bytes":77422},{"asset":"question_media/physics/nardebam_physics_1405_0669/stem_1.webp","sha256":"c79f5eca23e09f773e2f1fd0ae23c34b8d2f0cc79be216dafd9d0a04914e56c3","bytes":7506}],"provenance":{"edition":"nardebam_1405","question_number":669,"question_pdf":"6.pdf","question_page":17,"solution_page":332,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_physics_1405_0670","source_sha256":"f6df904e8d21cf841599f161460abccbd8a2f6f591fadf973f3111280fffb0de","subject":"physics","section_id":"physics_fields_circuits","source_topic_key":"current_electricity","source_difficulty":"hard","stem":[{"type":"text","text":"در مدار شکل روبه‌رو، وقتی کلید $k_1$ را می‌بندیم، ولت‌سنج مقدار $V_1$، وقتی کلید $k_2$ را باز و کلید $k_2$ را می‌بندیم، ولت‌سنج مقدار $V_2$ و وقتی هر دو کلید را می‌بندیم، ولت‌سنج مقدار $V_3$ را نشان می‌دهد. کدام رابطه درست است؟ (ولت‌سنج آرمانی است.)"},{"type":"image","asset":"question_media/physics/nardebam_physics_1405_0670/stem_1.webp","alt":"مدار الکتریکی با دو کلید، مقاومت‌ها و ولت‌سنج","aspect_ratio":0.3722}],"options":[[{"type":"text","text":"$V_2 > V_1 > V_3$"}],[{"type":"text","text":"$V_1 > V_3 > V_2$"}],[{"type":"text","text":"$V_3 > V_1 > V_2$"}],[{"type":"text","text":"$V_3 > V_2 > V_1$"}]],"solution":[{"type":"text","text":"مقاومت معادل مدار در سه حالت به ترتیب R1، R2 و R3 نوشته می‌شود و ترتیب R2>R1>R3 به دست می‌آید. هرچه مقاومت خارجی بزرگ‌تر باشد جریان کمتر و ولتاژ دو سر باتری بیشتر است؛ از جمع ولتاژهای R و R' نتیجه می‌شود V2>V1>V3."},{"type":"image","asset":"question_media/physics/nardebam_physics_1405_0670/solution_2.webp","alt":"مدار با ولت‌سنج روی R' برای مقایسه سه حالت","aspect_ratio":1.1005}],"smart_shortcut":null,"media_assets":["question_media/physics/nardebam_physics_1405_0670/solution_2.webp","question_media/physics/nardebam_physics_1405_0670/stem_1.webp"],"media_evidence":[{"asset":"question_media/physics/nardebam_physics_1405_0670/solution_2.webp","sha256":"cf02b647a5b24cf4d7c699164577b0d568768906fafcd356f1bef6f27e4339e7","bytes":18984},{"asset":"question_media/physics/nardebam_physics_1405_0670/stem_1.webp","sha256":"6d8dc44aa05a2ac3352a056cff8f045e069bb994e16da271e19167a82043ae90","bytes":7492}],"provenance":{"edition":"nardebam_1405","question_number":670,"question_pdf":"6.pdf","question_page":17,"solution_page":332,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_physics_1405_0671","source_sha256":"8bd1c8442a634772278c4c989535facc9228f9345f4af6f38fa3f745d00888e7","subject":"physics","section_id":"physics_fields_circuits","source_topic_key":"current_electricity","source_difficulty":"hard","stem":[{"type":"text","text":"لامپ‌های $A$، $B$ و $C$ در شکل روبه‌رو، همگی یکسان‌اند. با بستن کلید، اختلاف پتانسیل دو سر لامپ‌های $A$ و $B$ چند درصد و چگونه تغییر می‌کند؟"},{"type":"image","asset":"question_media/physics/nardebam_physics_1405_0671/stem_1.webp","alt":"مدار الکتریکی با سه لامپ و یک کلید","aspect_ratio":0.4066}],"options":[[{"type":"text","text":"$50$، کاهش"}],[{"type":"text","text":"کم‌تر از $50$، افزایش"}],[{"type":"text","text":"$50$، افزایش"}],[{"type":"text","text":"بیشتر از $50$، افزایش"}]],"solution":[{"type":"text","text":"با بستن کلید، دو سر لامپ C اتصال کوتاه می‌شود و مقاومت معادل کم می‌گردد؛ جریان کل زیاد می‌شود. در مدل منبع با مقاومت داخلی، ولتاژ دو سر منبع کاهش می‌یابد، اما جریان و اختلاف پتانسیل لامپ‌های A و B کمتر از 50٪ افزایش پیدا می‌کند."}],"smart_shortcut":null,"media_assets":["question_media/physics/nardebam_physics_1405_0671/stem_1.webp"],"media_evidence":[{"asset":"question_media/physics/nardebam_physics_1405_0671/stem_1.webp","sha256":"fde91be44174e89c666f5274ce19005ff1da1558de284053b8d38e19cdeffbe6","bytes":6996}],"provenance":{"edition":"nardebam_1405","question_number":671,"question_pdf":"6.pdf","question_page":17,"solution_page":332,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_physics_1405_0672","source_sha256":"a6347015623c055be8ea08010c4ffee074b5eb5ee79cf58ac9d2e55ddbfe3e56","subject":"physics","section_id":"physics_fields_circuits","source_topic_key":"current_electricity","source_difficulty":"hard","stem":[{"type":"text","text":"در شکل روبه‌رو، کلید $k_{1}$ را باز می‌کنیم و هم‌زمان کلید $k_{2}$ را می‌بندیم. توان مصرفی مقاومت‌های $۵\\Omega$ و $۶\\Omega$ به ترتیب از راست به چپ چگونه تغییر می‌کند؟"},{"type":"image","asset":"question_media/physics/nardebam_physics_1405_0672/stem_1.webp","alt":"مدار الکتریکی شامل مقاومت‌ها و کلیدهای k1 و k2","aspect_ratio":1.3678}],"options":[[{"type":"text","text":"افزایش، افزایش"}],[{"type":"text","text":"افزایش، کاهش"}],[{"type":"text","text":"کاهش، افزایش"}],[{"type":"text","text":"کاهش، کاهش"}]],"solution":[{"type":"text","text":"در حالت اول مقاومت 3Ω حذف می‌شود و مدار شامل R1=5Ω و معادل R23=1.5Ω است. سهم ولتاژها از تقسیم مقاومت‌ها محاسبه می‌شود. با باز کردن k1 و بستن k2، R2 حذف و R4=3Ω وارد مدار می‌شود؛ مقایسه ولتاژها نشان می‌دهد توان روی R1 کاهش و توان روی R2 افزایش می‌یابد."},{"type":"image","asset":"question_media/physics/nardebam_physics_1405_0672/solution_2.webp","alt":"مدار معادل حالت اول با R1 و R23","aspect_ratio":1.0394},{"type":"image","asset":"question_media/physics/nardebam_physics_1405_0672/solution_3.webp","alt":"مدار معادل حالت دوم با R24 و R1","aspect_ratio":0.6047}],"smart_shortcut":null,"media_assets":["question_media/physics/nardebam_physics_1405_0672/solution_2.webp","question_media/physics/nardebam_physics_1405_0672/solution_3.webp","question_media/physics/nardebam_physics_1405_0672/stem_1.webp"],"media_evidence":[{"asset":"question_media/physics/nardebam_physics_1405_0672/solution_2.webp","sha256":"f5707b87cfdff404ef61ca0b1c6cc0a20ae9d8af1a5ffaf9f6fbffe9bc4298a5","bytes":17190},{"asset":"question_media/physics/nardebam_physics_1405_0672/solution_3.webp","sha256":"ccfb899d496037e1cc396f2eb1643989ba8b576d09c037ec01b706d86623cfac","bytes":134186},{"asset":"question_media/physics/nardebam_physics_1405_0672/stem_1.webp","sha256":"b908c7453f9e78781fc1140b18458c9293a92546b3f129cfcadd0d98eea3969a","bytes":8554}],"provenance":{"edition":"nardebam_1405","question_number":672,"question_pdf":"6.pdf","question_page":18,"solution_page":332,"solution_origin":"source"},"source_answer_hidden":true},{"question_id":"nardebam_physics_1405_0673","source_sha256":"6fcae288d7262f19557e56c672dee28edb760a2059a7071c39f813efcd46af19","subject":"physics","section_id":"physics_fields_circuits","source_topic_key":"current_electricity","source_difficulty":"hard","stem":[{"type":"text","text":"در شکل روبه‌رو، با حرکت‌دادن رسانای لغزنده از نقطهٔ $A$ تا نقطهٔ $B$، روشنایی لامپ‌های $L_{1}$ و $L_{2}$ به ترتیب از راست به چپ چگونه تغییر می‌کنند؟"},{"type":"image","asset":"question_media/physics/nardebam_physics_1405_0673/stem_1.webp","alt":"مدار الکتریکی با رسانای لغزنده و لامپ‌های L1 و L2","aspect_ratio":1.2016}],"options":[[{"type":"text","text":"افزایش، افزایش"}],[{"type":"text","text":"افزایش، کاهش"}],[{"type":"text","text":"کاهش، افزایش"}],[{"type":"text","text":"کاهش، کاهش"}]],"solution":[{"type":"text","text":"لغزنده در C روی مقاومت AB قرار دارد و جریان فقط از بخش CB می‌گذرد؛ با حرکت لغزنده رو به پایین RCB کاهش می‌یابد. کاهش Req باعث افزایش جریان کل و کاهش ولتاژ دو سر منبع می‌شود، اما جریان شاخه دیگر زیاد می‌شود. نتیجه چاپی: روشنایی L1 کم و روشنایی L2 زیاد می‌شود."},{"type":"image","asset":"question_media/physics/nardebam_physics_1405_0673/solution_2.webp","alt":"مدار با لغزنده روی مقاومت AB و دو لامپ","aspect_ratio":0.6605}],"smart_shortcut":null,"media_assets":["question_media/physics/nardebam_physics_1405_0673/solution_2.webp","question_media/physics/nardebam_physics_1405_0673/stem_1.webp"],"media_evidence":[{"asset":"question_media/physics/nardebam_physics_1405_0673/solution_2.webp","sha256":"8a411338b9a8acb8bc901c7fc2195e93b49641ca420aae2a5477bc5240e012c0","bytes":22510},{"asset":"question_media/physics/nardebam_physics_1405_0673/stem_1.webp","sha256":"b093ccbd0b6fdd4e689ef432a6920c89ba0130e5321864f6d13a26be1c1b54a4","bytes":6842}],"provenance":{"edition":"nardebam_1405","question_number":673,"question_pdf":"6.pdf","question_page":18,"solution_page":333,"solution_origin":"source"},"source_answer_hidden":true}]}
