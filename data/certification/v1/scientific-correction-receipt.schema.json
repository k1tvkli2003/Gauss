{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gauss-scientific-correction-receipt-v1",
  "title": "Gauss scientific correction receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "batch_id",
    "question_id",
    "source_sha256",
    "runtime_record_sha256",
    "reviewer_id",
    "reviewed_on",
    "verdict",
    "source_conflict_receipt_id",
    "source_conflict_receipt_sha256",
    "corrected_fields",
    "correction_summary",
    "content_patch",
    "effective_record_sha256",
    "answer_mapping",
    "classification",
    "question_source",
    "solution_source",
    "evidence_files",
    "proof_evidence",
    "render_evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_id": { "type": "string", "minLength": 1 },
    "batch_id": { "type": "string", "minLength": 1 },
    "question_id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "runtime_record_sha256": { "$ref": "#/$defs/sha256" },
    "reviewer_id": { "type": "string", "minLength": 1 },
    "reviewed_on": { "type": "string", "format": "date" },
    "verdict": { "const": "scientifically_corrected" },
    "source_conflict_receipt_id": { "type": "string", "minLength": 1 },
    "source_conflict_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "corrected_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["stem", "options", "solution", "smart_shortcut"] }
    },
    "correction_summary": { "type": "string", "minLength": 32 },
    "content_patch": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "stem": { "type": "array" },
        "options": { "type": "array" },
        "solution": { "type": "array" },
        "smart_shortcut": { "type": ["array", "null"] }
      }
    },
    "effective_record_sha256": { "$ref": "#/$defs/sha256" },
    "answer_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immutable_source_option",
        "printed_source_option",
        "effective_option",
        "semantic_answer",
        "relation"
      ],
      "properties": {
        "immutable_source_option": { "$ref": "#/$defs/option" },
        "printed_source_option": { "$ref": "#/$defs/option" },
        "effective_option": { "$ref": "#/$defs/option" },
        "semantic_answer": { "type": "string", "minLength": 1 },
        "relation": {
          "const": "scientific_override_of_immutable_extracted_key"
        }
      }
    },
    "classification": {
      "type": "object",
      "required": [
        "registry_version",
        "section_id",
        "topic_key",
        "subtopic_key",
        "concept_tags",
        "secondary_concepts",
        "prerequisites"
      ]
    },
    "question_source": { "type": "object" },
    "solution_source": { "type": "object" },
    "evidence_files": { "type": "object" },
    "proof_evidence": { "type": "object" },
    "render_evidence": { "type": "object" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "option": { "type": "integer", "minimum": 1, "maximum": 4 }
  }
}
