{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gauss-source-repair-receipt-v1",
  "title": "Gauss source repair receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "batch_id",
    "question_id",
    "source_sha256",
    "runtime_record_sha256",
    "reviewer_id",
    "reviewed_on",
    "verdict",
    "conflict_receipt_id",
    "conflict_receipt_sha256",
    "repaired_fields",
    "verified_fields",
    "repair_summary",
    "content_patch",
    "effective_record_sha256",
    "answer_mapping",
    "question_source",
    "solution_source",
    "render_evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_id": { "type": "string", "minLength": 1 },
    "batch_id": { "type": "string", "minLength": 1 },
    "question_id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "runtime_record_sha256": { "$ref": "#/$defs/sha256" },
    "reviewer_id": { "type": "string", "minLength": 1 },
    "reviewed_on": { "type": "string", "format": "date" },
    "verdict": { "const": "repaired_matches_source" },
    "conflict_receipt_id": { "type": "string", "minLength": 1 },
    "conflict_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "repaired_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/patchField" }
    },
    "verified_fields": {
      "type": "array",
      "contains": { "const": "options" },
      "items": { "type": "string" }
    },
    "repair_summary": { "type": "string", "minLength": 16 },
    "content_patch": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "stem": { "type": "array" },
        "options": { "type": "array" },
        "solution": { "type": "array" },
        "smart_shortcut": { "type": ["array", "null"] }
      }
    },
    "effective_record_sha256": { "$ref": "#/$defs/sha256" },
    "answer_mapping": {
      "type": ["object", "null"],
      "properties": {
        "from_option": { "type": "integer", "minimum": 1, "maximum": 4 },
        "to_option": { "type": "integer", "minimum": 1, "maximum": 4 },
        "semantic_answer": { "type": "string", "minLength": 1 },
        "source_key_option": { "type": "integer", "minimum": 1, "maximum": 4 },
        "relation": {
          "const": "same_semantic_answer_after_source_option_recovery"
        }
      },
      "required": [
        "from_option",
        "to_option",
        "semantic_answer",
        "source_key_option",
        "relation"
      ],
      "additionalProperties": false
    },
    "question_source": { "type": "object" },
    "solution_source": { "type": "object" },
    "render_evidence": { "type": "object" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "patchField": {
      "enum": ["stem", "options", "solution", "smart_shortcut"]
    }
  }
}
