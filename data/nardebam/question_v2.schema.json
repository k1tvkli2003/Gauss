{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gauss Question V2",
  "type": "object",
  "required": ["id", "subject", "topic_key", "difficulty", "stem", "options", "correct_option_index", "solution", "provenance"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "subject": { "enum": ["math", "physics"] },
    "topic_key": { "type": "string" },
    "difficulty": { "enum": ["above_average", "hard", "very_hard", "olympiad"] },
    "stem": { "$ref": "#/$defs/content" },
    "options": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/content" }
    },
    "correct_option_index": { "type": "integer", "minimum": 1, "maximum": 4 },
    "solution": { "$ref": "#/$defs/content" },
    "smart_shortcut": { "anyOf": [{ "$ref": "#/$defs/content" }, { "type": "null" }] },
    "source_bank": { "enum": ["nardebam", "gauss"] },
    "provenance": {
      "type": "object",
      "required": ["kind", "edition"],
      "properties": {
        "kind": { "enum": ["source", "existing", "generated"] },
        "edition": { "type": "string" },
        "question_number": { "type": ["integer", "null"] },
        "question_pdf": { "type": ["string", "null"] },
        "question_page": { "type": ["integer", "null"] },
        "solution_page": { "type": ["integer", "null"] },
        "solution_origin": { "enum": ["source", "reconstructed", "existing"] }
      }
    }
  },
  "$defs": {
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "text"],
            "properties": { "type": { "const": "text" }, "text": { "type": "string", "minLength": 1 } }
          },
          {
            "type": "object",
            "required": ["type", "asset", "alt"],
            "properties": {
              "type": { "const": "image" },
              "asset": { "type": "string", "minLength": 1 },
              "alt": { "type": "string" },
              "aspect_ratio": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        ]
      }
    }
  }
}
