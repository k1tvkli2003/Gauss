{3-a}+\\frac{1}{3-b}}{2}=\\frac{6-a-b}{2(3-a)(3-b)}=\\frac{6-a-b}{6(6-a-b)}=\\frac{1}{6}$\nپس پاسخ صحیح گزینهٔ 4 است."}]}},{"question_id":"nardebam_math_1405_0095","subject":"math","topic_key":"patterns_sequences","section_id":"math_algebraic_foundations","subtopic_key":"patterns_sequences_geometric","concept_tags":["geometric_sequence","general_term"],"prerequisites":["exponents"],"reviewed_difficulty":"very_hard","source_sha256":"218448744dfc4b4cc42802df9a3ba48e85c598f43b89bad11bf60ee3b514f08e","runtime_record_sha256":"218448744dfc4b4cc42802df9a3ba48e85c598f43b89bad11bf60ee3b514f08e","effective_record_sha256":"218448744dfc4b4cc42802df9a3ba48e85c598f43b89bad11bf60ee3b514f08e","source_option_index":1,"effective_option_index":1,"solution_verified":true,"render_receipt_id":"flutter-render-v1-20260810","source_fidelity_receipt_id":"source-fidelity-math-0001:nardebam_math_1405_0095","content_patch":null},{"question_id":"nardebam_math_1405_0096","subject":"math","topic_key":"patterns_sequences","section_id":"math_algebraic_foundations","subtopic_key":"patterns_sequences_arithmetic","concept_tags":["arithmetic_sequence","general_term"],"prerequisites":["linear_equations"],"reviewed_difficulty":"hard","source_sha256":"55de6d94bb728994b1ce1dd29a50593155964bc60c1c9d6f08e0b02d7ff5a1d9","runtime_record_sha256":"55de6d94bb728994b1ce1dd29a50593155964bc60c1c9d6f08e0b02d7ff5a1d9","effective_record_sha256":"55de6d94bb728994b1ce1dd29a50593155964bc60c1c9d6f08e0b02d7ff5a1d9","source_option_index":2,"effective_option_index":2,"solution_verified":true,"render_receipt_id":"flutter-render-v1-20260810","source_fidelity_receipt_id":"source-fidelity-math-0001:nardebam_math_1405_0096","content_patch":null},{"question_id":"nardebam_math_1405_0097","subject":"math","topic_key":"patterns_sequences","section_id":"math_algebraic_foundations","subtopic_key":"patterns_sequences_geometric","concept_tags":["geometric_sequence","general_term"],"prerequisites":["exponents"],"reviewed_difficulty":"hard",